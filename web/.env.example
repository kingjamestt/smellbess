# Copy to .env.local and fill in. .env.local is gitignored: never commit real values.
# On Netlify, set the same names under Site configuration → Environment variables.
#
# No bank details here, or anywhere on the site: customers send their order on
# WhatsApp and we reply there with payment details.

# --- Supabase (Project settings → API keys) --------------------------------
SUPABASE_URL="https://your-project.supabase.co"
# Publishable key: only used to log admins in. RLS blocks it from every table.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key: full database access. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Admin -----------------------------------------------------------------
# Who can log in to /admin (comma separated). Also who gets new-order emails.
SMELLBESS_ADMIN_EMAILS="owner@example.com,partner@example.com"
# The site's public address, used in login links and order emails.
SMELLBESS_SITE_URL="http://localhost:3000"

# --- New-order email alerts (optional, resend.com) --------------------------
# RESEND_API_KEY="re_..."
# Until you verify a domain in Resend, its test sender only delivers to the
# email you signed up to Resend with.
# SMELLBESS_ALERT_FROM="Smell Bess <orders@your-domain>"

# --- Local development without Supabase ------------------------------------
# Leave the Supabase values out and the app uses a JSON file in ./.data.
# SMELLBESS_DEV_ADMIN=1   # opens /admin with no login (never works in production)
# SMELLBESS_DATA_DIR=".data"
