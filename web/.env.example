# Copy to .env.local and fill in. .env.local is gitignored: never commit real values.
#
# Bank accounts shown on the order confirmation screen for bank transfers.
# Server-side only (no NEXT_PUBLIC_ prefix). Numbered from 1; add _3, _4 ... as needed.
# To switch to a business account later, edit or reorder these.

SMELLBESS_BANK_1_BANK="Example Bank Ltd."
SMELLBESS_BANK_1_ACCOUNT_NAME="Account Holder Name"
SMELLBESS_BANK_1_ACCOUNT_TYPE="Savings"
SMELLBESS_BANK_1_ACCOUNT_NUMBER="0000000"

SMELLBESS_BANK_2_BANK="Another Bank Ltd."
SMELLBESS_BANK_2_ACCOUNT_NAME="Account Holder Name"
SMELLBESS_BANK_2_ACCOUNT_TYPE="Chequing"
SMELLBESS_BANK_2_ACCOUNT_NUMBER="000 000 000 000"

# Optional: where the JSON data store lives (orders, bottles, settings). Default: ./.data
# SMELLBESS_DATA_DIR=".data"
